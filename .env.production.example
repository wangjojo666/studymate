APP_NAME=StudyMate
APP_ENV=production
API_PREFIX=/api
# Replace this before starting with APP_ENV=production. Startup rejects this placeholder,
# the development default, and secrets shorter than 32 characters.
AUTH_SECRET_KEY=replace-with-a-long-random-production-secret
AUTH_TOKEN_EXPIRE_MINUTES=10080

# Default demo mode. No external API key is required with these values.
TEXT_LLM_PROVIDER=mock
TEXT_LLM_FALLBACK_PROVIDER=none
EMBEDDING_PROVIDER=hash
OCR_LLM_PROVIDER=mock
RERANK_PROVIDER=rule

RAG_TOP_K=5
RAG_MIN_SCORE=0.12
RAG_CONTEXT_MAX_CHARS=6000
RAG_ENABLE_STRICT_SOURCE_MODE=true

DOCUMENT_UPLOAD_MAX_BYTES=104857600
TXT_UPLOAD_MAX_BYTES=10485760
OFFICE_ZIP_MAX_FILES=2500
OFFICE_ZIP_MAX_MEMBER_BYTES=83886080
OFFICE_ZIP_MAX_TOTAL_UNCOMPRESSED_BYTES=209715200

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_ASK_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=20

CPP_RUN_ENABLED=false
# docker is not implemented in this codebase; production startup rejects local C++ execution.
CPP_RUN_SANDBOX=none
CPP_COMPILE_TIMEOUT_SECONDS=8
CPP_RUN_TIMEOUT_SECONDS=5
