APP_NAME=StudyMate
APP_ENV=production
API_PREFIX=/api
# Required. Generate a unique value outside the repository, for example with a
# password manager or `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# docker-compose.prod.yml refuses to render when this value is missing or empty.
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=10080
ENABLE_DEMO_USER=false

# Keep loopback when an HTTPS reverse proxy runs on the same host. Set an
# explicit interface only when the host firewall and TLS termination are ready.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
NGINX_CLIENT_MAX_BODY_SIZE=110m
INSTALL_CHROMA=false

# Default offline provider mode. No external API key is used with these values.
TEXT_LLM_PROVIDER=mock
TEXT_LLM_MODEL=
TEXT_LLM_BASE_URL=
TEXT_LLM_API_KEY=
TEXT_LLM_FALLBACK_PROVIDER=none
TEXT_LLM_FALLBACK_MODEL=
TEXT_LLM_FALLBACK_BASE_URL=
TEXT_LLM_FALLBACK_API_KEY=
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
OCR_LLM_PROVIDER=mock
OCR_LLM_MODEL=
OCR_LLM_BASE_URL=
OCR_DEFAULT_MAX_PAGES=10
OCR_MAX_PAGES_PER_REQUEST=20
RERANK_PROVIDER=rule

RAG_TOP_K=5
RAG_MIN_SCORE=0.12
RAG_CONTEXT_MAX_CHARS=6000
RAG_ENABLE_STRICT_SOURCE_MODE=true

DOCUMENT_UPLOAD_MAX_BYTES=104857600
TXT_UPLOAD_MAX_BYTES=10485760
OFFICE_ZIP_MAX_FILES=2500
OFFICE_ZIP_MAX_MEMBER_BYTES=83886080
OFFICE_ZIP_MAX_TOTAL_UNCOMPRESSED_BYTES=209715200

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_ASK_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=20

CPP_RUN_ENABLED=false
# docker is not implemented in this codebase; production startup rejects local C++ execution.
CPP_RUN_SANDBOX=none
CPP_COMPILE_TIMEOUT_SECONDS=8
CPP_RUN_TIMEOUT_SECONDS=5
CPP_OUTPUT_LIMIT_BYTES=262144

# Provider-specific fallbacks. Populate only the provider that is enabled.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
